{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.cmd\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.cmd\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.cmd\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
